{
  "name": "@prayer/sdk",
  "version": "0.1.0-alpha.0",
  "description": "High-level TypeScript SDK for Prayer automation clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewBlanchard/prayer.rs.git",
    "directory": "prayer-sdk-ts"
  },
  "keywords": ["prayer", "sdk", "automation", "spacemolt"],
  "type": "module",
  "engines": { "node": ">=22", "npm": ">=10 <12" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./api": { "types": "./dist/src/api.d.ts", "import": "./dist/src/api.js" },
    "./types": { "types": "./dist/src/types.d.ts", "import": "./dist/src/types.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "generate": "node scripts/generate-types.mjs && node scripts/generate-api.mjs",
    "build": "tsc -p tsconfig.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "node scripts/check-generated-contracts.mjs && node scripts/check-generated-drift.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json && tsc -p tsconfig.examples.json && npm run api:check",
    "api:report": "npm run build && node scripts/api-report.mjs --write",
    "api:check": "npm run build && node scripts/api-report.mjs",
    "test:package": "node scripts/test-package.mjs",
    "smoke:credentialed": "node scripts/credentialed-smoke.mjs"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
