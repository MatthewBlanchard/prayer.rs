# Required only when connecting live SpaceMolt accounts
SPACEMOLT_CLERK_API_KEY=replace-with-your-clerk-key

# Prayer API defaults (loopback is recommended)
PRAYER_RS_BIND=127.0.0.1:7777
PRAYER_API_TOKEN=replace-when-binding-api-beyond-loopback
PRAYER_URL=http://127.0.0.1:7777
PRAYER_CLIENT_API_URL=http://127.0.0.1:7777

# Optional persistent state locations (defaults live under the working directory)
PRAYER_KNOWLEDGE_STATE_PATH=
PRAYER_SESSION_STATE_PATH=
PRAYER_CLIENT_JOBS_PATH=
PRAYER_CLIENT_JOB_RUNS_PATH=
PRAYER_CLIENT_SQUADS_PATH=
PRAYER_LOG_DIR=
