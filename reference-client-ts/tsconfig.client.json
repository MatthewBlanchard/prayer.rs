{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/client/**/*", "src/shared/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
